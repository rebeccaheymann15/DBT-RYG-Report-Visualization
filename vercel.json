{
  "version": 2,
  "buildCommand": "npm --prefix client install && npm --prefix client run build",
  "installCommand": "npm install",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/server.js"
    },
    {
      "source": "/:path*",
      "destination": "/:path*/index.html"
    }
  ]
}
