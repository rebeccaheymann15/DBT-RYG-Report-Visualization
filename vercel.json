{
  "version": 2,
  "buildCommand": "npm install && npm --prefix client install && npm --prefix client run build",
  "installCommand": "npm install",
  "outputDirectory": "client/dist",
  "functions": {
    "api/handler.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/handler.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
