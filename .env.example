# Neon PostgreSQL Connection
# Get your connection string from https://console.neon.tech
# IMPORTANT: Remove &channel_binding=require from the connection string if present
# This parameter can cause TLS connection issues
DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-1.neon.tech/dbname?sslmode=require

# Node environment
NODE_ENV=development

# Server port (for local development)
PORT=5000
