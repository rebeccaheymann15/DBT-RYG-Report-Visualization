{
  "name": "dbt-ryg-report-visualization",
  "version": "1.0.0",
  "type": "module",
  "description": "Excel to RYG Report Visualization Webapp",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "build": "npm install && npm --prefix client install && npm --prefix client run build",
    "install:all": "npm install && cd client && npm install && cd .."
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "xlsx": "^0.18.5",
    "bcrypt": "^5.1.1",
    "express-session": "^1.17.3",
    "connect-pg-simple": "^7.0.0",
    "nodemailer": "^6.9.7",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
